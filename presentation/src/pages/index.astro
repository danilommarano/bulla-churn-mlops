---
import Base from "../layouts/Base.astro";
import Deck from "../components/Deck.astro";
import Slide from "../components/Slide.astro";
import CodeDiff from "../components/CodeDiff.astro";
import VertexOssMap from "../components/VertexOssMap.astro";
import Mermaid from "../components/Mermaid.astro";
import ModelPlayground from "../components/ModelPlayground.astro";
import MetricCard from "../components/MetricCard.astro";
import ConfusionMatrix from "../components/ConfusionMatrix.astro";
import Timeline from "../components/Timeline.astro";
import metrics from "../data/metrics.json";
import { SLIDES } from "../data/slides";
import { Image } from "astro:assets";
import mlflowRuns from "../assets/mlflow-runs.png";
import evidentlyDrift from "../assets/evidently-drift.png";

const meta = (id: number) => SLIDES.find((s) => s.id === id)!;

// Detalhe do modelo recebido (slide 3) — fatos extraídos do código-fonte.
const modelFacts = [
  { k: "Algoritmo", v: "Regressão logística", d: 'class_weight="balanced" · max_iter=500 · seed 42' },
  { k: "Alvo", v: "turnover (0/1)", d: "base ~20% churn — problema desbalanceado" },
  { k: "Entrada", v: "12 colunas", d: "Customer-Churn-Records.csv — numéricas + Geography / Gender / Card Type" },
  { k: "Features derivadas", v: "3 engenheiradas", d: "balance_per_product · geography_churn_rate · age_bucket" },
];
---

<Base>
  <Deck>
    <Slide meta={meta(1)} active>
      <p class="text-base text-[var(--muted)]">
        Danilo Matrangolo Marano ·
        <a class="text-[var(--accent)] underline-offset-4 hover:underline" href="mailto:danilo.m.marano@gmail.com">
          danilo.m.marano@gmail.com
        </a>
      </p>
    </Slide>
    <Slide meta={meta(2)} />
    <Slide meta={meta(3)}>
      <div class="mx-auto grid max-w-3xl gap-4 text-left sm:grid-cols-2">
        {modelFacts.map((f) => (
          <div class="rounded-xl border border-black/10 bg-[var(--panel)] p-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-[var(--muted)]">{f.k}</p>
            <p class="mt-1 text-lg font-medium">{f.v}</p>
            <p class="mt-1 text-sm text-[var(--muted)]">{f.d}</p>
          </div>
        ))}
      </div>
      <p class="mt-6 text-sm text-[var(--muted)]">
        Um único <span class="font-medium text-[var(--ink)]">Pipeline sklearn</span> encapsula
        pré-processo + modelo: o mesmo objeto treina, versiona e prediz — sem re-fit na inferência.
      </p>
    </Slide>
    <Slide meta={meta(4)}><VertexOssMap /></Slide>
    <Slide meta={meta(5)} />
    <Slide meta={meta(6)}><CodeDiff /></Slide>
    <Slide meta={meta(7)}><Mermaid /></Slide>
    <Slide meta={meta(8)}><ModelPlayground /></Slide>
    <Slide meta={meta(9)}>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
        <MetricCard label="ROC AUC" value={metrics.roc_auc.toFixed(3)} note="separa bem" />
        <MetricCard label="Recall" value={metrics.recall.toFixed(3)} note="o que importa" />
        <MetricCard label="Precision" value={metrics.precision.toFixed(3)} />
        <MetricCard label="Accuracy" value={metrics.accuracy.toFixed(3)} note="engana" />
      </div>
      <div class="mt-8">
        <ConfusionMatrix />
      </div>
    </Slide>
    <Slide meta={meta(10)}>
      <div class="grid gap-6 text-left md:grid-cols-2">
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-6">
          <p class="text-sm font-semibold text-emerald-700">make monitor — holdout saudável</p>
          <p class="mt-2 font-mono text-sm">[PASS] drift_share=0.000 · drifted_columns=0 · exit 0</p>
          <p class="mt-2 text-sm text-[var(--muted)]">accuracy 0.67 · roc_auc 0.76 · o gate deixa passar.</p>
        </div>
        <div class="rounded-xl border border-red-200 bg-red-50 p-6">
          <p class="text-sm font-semibold text-red-700">make monitor-drift — drift simulado</p>
          <p class="mt-2 font-mono text-sm">[ALERT] drift_share=0.462 · drifted_columns=6 · exit 2</p>
          <p class="mt-2 text-sm text-[var(--muted)]">accuracy 0.23 · recall 0.99 = "prevê que todos saem". Gatilho de re-treino.</p>
        </div>
      </div>
      <Image src={evidentlyDrift} alt="Relatório de drift do Evidently" class="mx-auto mt-6 max-h-64 w-auto rounded-lg border" />
    </Slide>
    <Slide meta={meta(11)}>
      <Timeline />
      <Image src={mlflowRuns} alt="Runs registradas no MLflow" class="mx-auto mt-6 max-h-64 w-auto rounded-lg border" />
    </Slide>
    <Slide meta={meta(12)} />
    <Slide meta={meta(13)} />
  </Deck>
</Base>
